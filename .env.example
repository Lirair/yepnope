# ==============================================================================
# YepNope — Variabili d'Ambiente
# Copia questo file in `.env.local` e inserisci le tue chiavi.
#
# NOTA: Anche senza compilare queste variabili l'app funziona subito in
# Modalità Demo locale (localStorage + BroadcastChannel multi-tab) e con
# il mazzo mock realistico di 15 film per la categoria "Cosa guardiamo".
# ==============================================================================

# Supabase (Database PostgreSQL + Realtime)
# Trovi questi valori in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB (The Movie Database) — SOLO LATO SERVER (mai prefisso NEXT_PUBLIC_)
# Crea una API Key v3 (o Read Access Token v4) su https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# URL pubblico opzionale dell'app (usato per meta tag OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
